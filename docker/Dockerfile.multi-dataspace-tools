RUN apk --no-cache add curl jq openssl

COPY --chmod=755 scripts/init-tmforum-multi-dataspace.sh /scripts/init-tmforum-multi-dataspace.sh
COPY --chmod=755 scripts/verify-multi-dataspace.sh /scripts/verify-multi-dataspace.sh
