<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>fdsc-edc</artifactId>
    <groupId>org.seamware.edc</groupId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>controlplane-dcp</artifactId>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <configuration>
          <skip>false</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.fabric8</groupId>
        <artifactId>docker-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>debug</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <skip>true</skip>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.edc</groupId>
      <artifactId>controlplane-virtual-base-bom</artifactId>
      <version>0.18.1</version>
      <type>pom</type>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <artifactId>data-plane-signaling</artifactId>
          <groupId>org.eclipse.edc</groupId>
        </exclusion>
        <exclusion>
          <artifactId>data-plane-signaling-oauth2</artifactId>
          <groupId>org.eclipse.edc</groupId>
        </exclusion>
        <exclusion>
          <artifactId>control-plane-contract-task-executor</artifactId>
          <groupId>org.eclipse.edc</groupId>
        </exclusion>
        <exclusion>
          <artifactId>control-plane-transfer-task-executor</artifactId>
          <groupId>org.eclipse.edc</groupId>
        </exclusion>
        <exclusion>
          <artifactId>jetty-websocket</artifactId>
          <groupId>org.eclipse.jetty.websocket</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.edc</groupId>
      <artifactId>controlplane-virtual-feature-dcp-bom</artifactId>
      <version>0.18.1</version>
      <type>pom</type>
      <scope>compile</scope>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.squareup.okio</groupId>
        <artifactId>okio</artifactId>
        <version>${version.com.squareup.okio}</version>
      </dependency>
      <dependency>
        <groupId>com.squareup.okio</groupId>
        <artifactId>okio-jvm</artifactId>
        <version>${version.com.squareup.okio}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <properties>
    <version.com.squareup.okio>3.16.4</version.com.squareup.okio>
  </properties>
</project>
