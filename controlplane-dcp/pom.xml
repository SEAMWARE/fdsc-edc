<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.seamware.edc</groupId>
        <artifactId>fdsc-edc</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>controlplane-dcp</artifactId>

    <properties>
        <!-- the okio release EDC's okhttp-jvm 5.3.2 is built against -->
        <version.com.squareup.okio>3.16.4</version.com.squareup.okio>
    </properties>

    <!-- Nearest-wins would otherwise pick okio 3.6.0 from our modules' okhttp 4.12.0, and every
         outgoing HTTP call fails with NoSuchMethodError: okio.Okio.socket. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio</artifactId>
                <version>${version.com.squareup.okio}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio-jvm</artifactId>
                <version>${version.com.squareup.okio}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Virtual participant-context mode: one runtime serves several participant contexts
             (one per dataspace) over dsp-virtual and management API v5 with OAuth2. The EDC BOMs
             are aggregators with plain <dependencies>, so they are used as pom dependencies. -->
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>controlplane-virtual-base-bom</artifactId>
            <version>${edc.version}</version>
            <type>pom</type>
            <exclusions>
                <!-- data-plane-signaling provides a second DataFlowController; the legacy one
                     below must stay the only one (docs/migration/EDC-0.18.1-UPGRADE.md §8). -->
                <exclusion>
                    <groupId>org.eclipse.edc</groupId>
                    <artifactId>data-plane-signaling</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.edc</groupId>
                    <artifactId>data-plane-signaling-oauth2</artifactId>
                </exclusion>
                <!-- the task executors only enqueue tasks, which nothing consumes without the
                     NATS feature; the contract and transfer managers below drive the state
                     machines instead. -->
                <exclusion>
                    <groupId>org.eclipse.edc</groupId>
                    <artifactId>control-plane-contract-task-executor</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.edc</groupId>
                    <artifactId>control-plane-transfer-task-executor</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.jetty.websocket</groupId>
                    <artifactId>jetty-websocket</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>controlplane-virtual-feature-dcp-bom</artifactId>
            <version>${edc.version}</version>
            <type>pom</type>
        </dependency>

        <dependency>
            <groupId>org.seamware.edc</groupId>
            <artifactId>dcp-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.seamware.edc</groupId>
            <artifactId>tmf-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.seamware.edc</groupId>
            <artifactId>fdsc-transfer-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.seamware.edc</groupId>
            <artifactId>policy-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- seeds the participant contexts declared under fdsc.participants.* -->
        <dependency>
            <groupId>org.seamware.edc</groupId>
            <artifactId>participant-bootstrap-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.seamware.edc</groupId>
            <artifactId>edr-api-extension</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>control-plane-api-client</artifactId>
            <version>${edc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>vault-hashicorp</artifactId>
            <version>${edc.version}</version>
        </dependency>
        <!-- the contract-negotiation and transfer-process state machines. control-plane-core
             no longer brings them in since 0.18, and the virtual BOM replaces them with task
             executors (excluded above), so without them no negotiation or transfer leaves its
             initial state. -->
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>control-plane-contract-manager</artifactId>
            <version>${edc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>control-plane-transfer-manager</artifactId>
            <version>${edc.version}</version>
        </dependency>
        <!-- The legacy flow controller. The FDSC transfer runs in the data plane embedded in
             this controlplane, which the legacy client (data-plane-signaling-client, from the
             BOM) calls in-process. data-plane-signaling replaces it from 0.18.x onwards, but it
             only reaches data planes over HTTP and selects them per participant context, so no
             transfer could start with it. Both provide the single DataFlowController: only one
             of them can be on the classpath. -->
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>transfer-data-plane-signaling</artifactId>
            <version>${edc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>edr-store-receiver</artifactId>
            <version>${edc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>edr-store-core</artifactId>
            <version>${edc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.edc</groupId>
            <artifactId>edr-store-spi</artifactId>
            <version>${edc.version}</version>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>debug</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
